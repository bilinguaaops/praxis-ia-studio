# ==============================================================================
# PRAXIS SAAS - FICHIER D'EXEMPLE DES VARIABLES D'ENVIRONNEMENT (.env.example)
# ==============================================================================

# 1. MOTEURS D'INTELLIGENCE ARTIFICIELLE
GEMINI_API_KEY="your_google_gemini_api_key_here"
ANTHROPIC_API_KEY=""
CLAUDE_MODEL="claude-3-5-haiku-20241022"

# 2. PAIEMENTS EN LIGNE PAYSTACK
PAYSTACK_SECRET_KEY="sk_live_xxxxxxxxxxxxxxxxxxxxxxxx"
PAYSTACK_PUBLIC_KEY="pk_live_xxxxxxxxxxxxxxxxxxxxxxxx"

# 3. SÉCURITÉ & DASHBOARD ADMINISTRATEUR PRAXIS
ADMIN_MASTER_PASSWORD="your_strong_admin_password"

# 4. GESTION DES QUOTAS ENSEIGNANTS
FREE_TRIAL_QUOTA="15"

# 5. NOTIFICATIONS INSTANTANÉES TELEGRAM
TELEGRAM_BOT_TOKEN="your_bot_token_from_botfather"
TELEGRAM_CHAT_ID="your_telegram_chat_id"

# 6. AUTHENTIFICATION SUPABASE (Optionnel)
VITE_SUPABASE_URL="https://your-project.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="your-supabase-publishable-key"
